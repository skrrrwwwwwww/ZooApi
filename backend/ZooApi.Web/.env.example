POSTGRES_DB=zoo_db
POSTGRES_USER=zoo_user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

RABBITMQ_USER=zoo_user
RABBITMQ_PASS=replace-with-a-long-random-rabbitmq-password

# Письма. Локально (Development) пароль берётся из user secrets, а контейнер
# работает в Production, поэтому нужен здесь. У Gmail это пароль приложения,
# а не основной пароль аккаунта.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# HTTPS issuer URL and API audience configured in your external identity provider.
JWT_AUTHORITY=https://identity.example.com/
JWT_AUDIENCE=zooapi
