{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "MassTransit": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "RabbitMq": {
    "Host": "localhost"
  },
  "MailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587
  },
  "Authentication": {
    "Authority": "",
    "Audience": ""
  },
  "AllowedHosts": "*"
}
